# Clinical AI Chatbot Agent Environment Configuration
PROJECT_NAME="clinical-ai-chatbot-agent"
API_V1_PREFIX="/api/v1"

# Groq API Configuration
GROQ_API_KEY="your_groq_api_key_here"
GROQ_DEFAULT_MODEL="qwen/qwen3.8-27b"
GROQ_FALLBACK_MODEL="openai/gpt-oss-120b"

# Security (ISO 27001 & Permenkes RME)
JWT_SECRET_KEY="replace_with_strong_production_secret_key"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Redis Caching (defaults to redis://localhost:6379/0, falls back automatically to in-memory)
REDIS_URL="redis://localhost:6379/0"

# --- Deployment online (Vercel + Neon) ---
ENVIRONMENT="development"          # gunakan "production" di Vercel
# DATABASE_URL="postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require"  # kosong = SQLite lokal
# CRON_SECRET="random_long_string"   # Vercel cron mengirim "Authorization: Bearer <CRON_SECRET>"
# ADMIN_BOOTSTRAP_PASSWORD="strong_password"  # wajib di production agar admin awal dibuat
# CORS_ORIGINS="https://app.example.com,https://other.example.com"
# BACKEND_API_URL="https://your-project.vercel.app"  # untuk proxy Next.js
