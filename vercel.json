{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/**/*.py": {
      "includeFiles": "{services/ai-api/**,datasets/raw/df_clinical_combined.csv,datasets/sft/sft_fast.jsonl,datasets/sft/sft_thinking.jsonl,datasets/inbox/penyakit_umum_awam.jsonl,datasets/inbox/clinical_cases.jsonl}",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/(health|docs|openapi.json)",
      "destination": "/api/index.py"
    }
  ],
  "crons": [
    {
      "path": "/api/v1/admin/jobs/process",
      "schedule": "0 3 * * *"
    }
  ]
}
